{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/workflow.v1.schema.json",
  "title": "Linura Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "trigger",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    }
  }
}
