{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.dev/schemas/portable-profile.v1.schema.json",
  "title": "Linura Portable Machine Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "intents",
    "constraints"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hardware_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
