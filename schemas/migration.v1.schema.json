{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/migration.v1.schema.json",
  "title": "Linura migration descriptor",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "introduced_in",
    "scope",
    "reversible",
    "requires_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "system",
        "user",
        "intent",
        "graph",
        "profile"
      ]
    },
    "reversible": {
      "type": "boolean"
    },
    "requires_snapshot": {
      "type": "boolean"
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "ledger",
        "ledger_id",
        "checksum_domain"
      ],
      "properties": {
        "ledger": {
          "type": "string",
          "minLength": 1
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1
        },
        "checksum_domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-linura-contract-id": "schema.migration.v1",
  "x-linura-stability": "experimental"
}
