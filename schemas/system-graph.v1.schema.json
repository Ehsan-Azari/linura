{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.dev/schemas/system-graph.v1.schema.json",
  "title": "Linura System Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "intent",
              "requirement",
              "capability",
              "workflow",
              "resource"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "requires",
              "provides",
              "conflicts",
              "replaces",
              "recommends",
              "optional",
              "owns",
              "shared-by",
              "derived-from",
              "realizes"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
