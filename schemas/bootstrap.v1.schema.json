{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.org/schemas/bootstrap.v1.schema.json",
  "title": "Linura bootstrap checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "install_id",
    "mode",
    "completed_stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "install_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "interactive",
        "non_interactive",
        "recovery"
      ]
    },
    "completed_stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "x-linura-contract-id": "schema.bootstrap.v1",
  "x-linura-stability": "experimental"
}
