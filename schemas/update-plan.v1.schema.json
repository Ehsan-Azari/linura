{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.dev/schemas/update-plan.v1.schema.json",
  "title": "Linura coordinated update plan",
  "type": "object",
  "required": ["schema_version", "candidate", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {"type": "string", "minLength": 1},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
