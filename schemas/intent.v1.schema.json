{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linura.dev/schemas/intent.v1.schema.json",
  "title": "Linura Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "status",
    "requirements"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "suspended",
        "superseded",
        "retired"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "goal",
              "constraint",
              "preference",
              "prohibition"
            ]
          },
          "statement": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
